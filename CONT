            window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(getShareURL())}`, '_blank');
        }

        function shareToReddit() {
            let title = `IGCSE Environmental Analysis: Eco vs Durable vs Budget options for ${currentAnalyzedProduct}`;
            window.open(`https://www.reddit.com/submit?url=${encodeURIComponent(getShareURL())}&title=${encodeURIComponent(title)}`, '_blank');
        }

        function copyShareLink() {
            let dummy = document.createElement('input');
            document.body.appendChild(dummy);
            dummy.value = getShareURL();
            dummy.select();
            document.execCommand('copy');
            document.body.removeChild(dummy);
            alert('Website link copied to clipboard!');
        }
